.ring {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #3b2e2a;
  box-shadow: 0 6rpx 0 rgba(59, 46, 42, 0.16);
  flex: none;
}

.ring-inner {
  background: #fffdf7;
  border: 3rpx solid #3b2e2a;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.1;
}

.ring-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #3b2e2a;
}

.ring-label {
  font-size: 20rpx;
  color: #9a8a78;
  margin-top: 2rpx;
}
