/* 成就墙 */
.achievements-page {
  padding-bottom: 80rpx;
}

.ach-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 26rpx;
  background: linear-gradient(160deg, #fff3d1 0%, #ffe08a 100%);
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 0 rgba(59, 46, 42, 0.15);
}

.ach-hero-left {
  flex: 1;
  min-width: 0;
}

.ach-hero-count {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 10rpx;
}

.ach-num {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.ach-total {
  font-size: 20rpx;
  color: var(--ink-soft);
}

.ach-bar {
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.7);
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 16rpx;
}

.filter-chip {
  padding: 7rpx 22rpx;
  background: #fffdf7;
  border: 3rpx solid rgba(59, 46, 42, 0.22);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-soft);
}

.filter-chip.is-active {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}

.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ach-card {
  width: calc((100% - 16rpx) / 2);
  padding: 20rpx;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 26rpx;
  box-shadow: 0 6rpx 0 rgba(59, 46, 42, 0.12);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ach-card.is-locked {
  background: #f7f1e6;
  border-color: rgba(59, 46, 42, 0.3);
  box-shadow: 0 6rpx 0 rgba(59, 46, 42, 0.08);
}

.ach-card.is-unlocked {
  background: #fff9e8;
}

.ach-emoji-wrap {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 3rpx solid var(--ink);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 0 rgba(59, 46, 42, 0.16);
}

.is-locked .ach-emoji-wrap {
  filter: grayscale(0.9);
  opacity: 0.7;
}

.ach-emoji {
  font-size: 38rpx;
}

.ach-check {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  color: #fff;
  border: 2rpx solid var(--ink);
  border-radius: 50%;
  font-size: 16rpx;
  font-weight: 800;
}

.ach-lock {
  position: absolute;
  right: -6rpx;
  top: -10rpx;
  font-size: 20rpx;
}

.ach-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.ach-desc {
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.4;
  margin-top: 2rpx;
  min-height: 50rpx;
}

.ach-progress {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ach-progress .bar {
  flex: 1;
}

.ach-count {
  flex: none;
  font-size: 17rpx;
  color: var(--muted);
  font-weight: 700;
}

.ach-tip {
  margin-top: 24rpx;
  padding: 16rpx;
  background: var(--yellow-soft);
  border-radius: 18rpx;
  font-size: 19rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}
