/* 关于 */
.about-page {
  padding-bottom: 80rpx;
}

.brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 20rpx 30rpx;
  background: linear-gradient(180deg, #dcefff 0%, #fff7e8 100%);
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 0 rgba(59, 46, 42, 0.14);
  overflow: hidden;
}

.brand-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.d1 {
  width: 200rpx;
  height: 200rpx;
  left: -70rpx;
  top: -80rpx;
}

.d2 {
  width: 140rpx;
  height: 140rpx;
  right: -50rpx;
  bottom: 40rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  margin-top: 4rpx;
}

.brand-en {
  font-size: 16rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
  font-weight: 700;
}

.brand-slogan {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-soft);
}

.brand-version {
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  background: #fffdf7;
  border: 2rpx solid rgba(59, 46, 42, 0.2);
  border-radius: 999rpx;
  font-size: 17rpx;
  color: var(--muted);
}

.feature-card,
.info-card {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 0 rgba(59, 46, 42, 0.11);
}

.feature-title {
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed var(--line);
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-emoji {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cream);
  border: 2rpx solid rgba(59, 46, 42, 0.18);
  border-radius: 18rpx;
  font-size: 28rpx;
}

.feature-name {
  display: block;
  font-size: 23rpx;
  font-weight: 800;
}

.feature-desc {
  display: block;
  font-size: 19rpx;
  color: var(--muted);
  line-height: 1.5;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx dashed var(--line);
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  flex: none;
  font-size: 20rpx;
  color: var(--muted);
}

.info-value {
  flex: 1;
  font-size: 20rpx;
  font-weight: 600;
}

.copy-btn {
  margin-top: 14rpx;
  padding: 12rpx;
  text-align: center;
  background: var(--blue-soft);
  border-radius: 14rpx;
  font-size: 19rpx;
  color: #1f6ea8;
  font-weight: 700;
}

.about-note {
  margin-top: 22rpx;
  padding: 22rpx;
  background: var(--yellow-soft);
  border: 3rpx dashed rgba(59, 46, 42, 0.25);
  border-radius: 26rpx;
}

.note-title {
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.note-text {
  display: block;
  font-size: 19rpx;
  line-height: 1.65;
  color: var(--ink-soft);
  margin-bottom: 6rpx;
}

.about-footer {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.copyright {
  font-size: 17rpx;
  color: var(--muted);
}
