/* 词根拼图 */
.puzzle-page {
  min-height: 100vh;
}

.puzzle-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0 20rpx;
}

.progress-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-wrap .bar {
  flex: 1;
}

.progress-text {
  font-size: 21rpx;
  font-weight: 800;
  color: var(--ink-soft);
}

.score-chip {
  flex: none;
  padding: 4rpx 14rpx;
  background: var(--yellow);
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.combo-chip {
  flex: none;
  padding: 4rpx 12rpx;
  background: var(--pink);
  color: #fff;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  animation: pulse 0.8s infinite;
}

.target-card {
  position: relative;
  padding: 30rpx 26rpx 26rpx;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 34rpx;
  box-shadow: 0 10rpx 0 rgba(59, 46, 42, 0.14);
  text-align: center;
}

.target-tag {
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  padding: 3rpx 12rpx;
  background: var(--purple);
  color: #fff;
  border: 2rpx solid var(--ink);
  border-radius: 10rpx;
  font-size: 17rpx;
  font-weight: 800;
  transform: rotate(-3deg);
}

.target-cn {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 24rpx;
  line-height: 1.4;
}

.target-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  margin-top: 26rpx;
  min-height: 100rpx;
}

.slots.is-shake {
  animation: wiggle 0.4s;
}

.slot {
  min-width: 96rpx;
  height: 92rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cream);
  border: 3rpx dashed rgba(59, 46, 42, 0.3);
  border-radius: 18rpx;
}

.slot.is-filled {
  background: var(--purple-soft);
  border: 3rpx solid var(--ink);
  box-shadow: 0 4rpx 0 var(--ink);
}

.slot-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--purple);
}

.slot-empty {
  font-size: 28rpx;
  color: rgba(59, 46, 42, 0.25);
  font-weight: 800;
}

.slot-plus {
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(59, 46, 42, 0.3);
}

.target-hint {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
  font-size: 20rpx;
  color: var(--muted);
}

/* 碎片池 */
.pool-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 4rpx 14rpx;
}

.pool-label {
  font-size: 28rpx;
  font-weight: 800;
}

.pool-sub {
  font-size: 19rpx;
  color: var(--muted);
}

.pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--blue-soft);
  border: 3rpx solid rgba(59, 46, 42, 0.2);
  border-radius: 28rpx;
  min-height: 180rpx;
}

.piece {
  position: relative;
  min-width: 104rpx;
  height: 84rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 18rpx;
  box-shadow: 0 5rpx 0 var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.piece::before {
  content: "";
  position: absolute;
  left: -10rpx;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-top: -9rpx;
  background: inherit;
  border: 4rpx solid var(--ink);
  border-radius: 50%;
  z-index: -1;
}

.piece.is-used {
  opacity: 0.25;
  box-shadow: none;
  transform: translateY(4rpx);
}

.piece.is-hint {
  background: var(--yellow);
  animation: pulse 0.9s infinite;
}

/* 操作 */
.controls {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.ctrl {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf7;
  border: 3rpx solid var(--ink);
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 5rpx 0 rgba(59, 46, 42, 0.18);
}

.check-btn {
  margin-top: 20rpx;
}

/* 结算 */
.done-card {
  margin-top: 40rpx;
  padding: 40rpx 30rpx 32rpx;
  background: #fffdf7;
  border: 5rpx solid var(--ink);
  border-radius: 40rpx;
  box-shadow: 0 14rpx 0 rgba(59, 46, 42, 0.16);
  text-align: center;
}

.done-emoji {
  font-size: 100rpx;
  margin-top: 16rpx;
}

.done-score {
  font-size: 100rpx;
  font-weight: 800;
  line-height: 1.1;
  color: var(--purple);
}

.done-label {
  font-size: 21rpx;
  color: var(--muted);
}

.done-best {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--orange-deep);
}

.done-tip {
  margin: 22rpx 0;
  padding: 18rpx;
  background: var(--purple-soft);
  border-radius: 20rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--ink-soft);
  text-align: left;
}

/* 成功弹层 */
.result-modal {
  text-align: center;
  position: relative;
}

.result-spark {
  position: absolute;
  right: 30rpx;
  top: 20rpx;
  color: var(--yellow);
  font-size: 34rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--green);
}

.result-word {
  font-size: 60rpx;
  font-weight: 800;
  margin-top: 12rpx;
  line-height: 1.2;
}

.result-phonetic {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.result-example {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--blue-soft);
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: left;
}

.result-root {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.result-root-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 14rpx;
  background: var(--cream);
  border: 2rpx solid rgba(59, 46, 42, 0.2);
  border-radius: 12rpx;
}

.result-root-t {
  font-size: 21rpx;
  font-weight: 800;
  color: var(--purple);
}

.result-root-m {
  font-size: 15rpx;
  color: var(--muted);
}

.result-tip {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: var(--ink-soft);
  text-align: left;
  line-height: 1.5;
}
