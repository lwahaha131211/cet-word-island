/* 首页 */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hello-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.4;
}

.hello-sub {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.wallet {
  display: flex;
  gap: 10rpx;
  flex: none;
}

.wallet-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  background: #fff;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 0 rgba(59, 46, 42, 0.18);
}

.wallet-icon {
  font-size: 22rpx;
}

.wallet-num {
  font-size: 24rpx;
  font-weight: 800;
}

/* 主视觉 */
.hero {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(160deg, #ffe9c4 0%, #ffd166 100%);
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 0 rgba(59, 46, 42, 0.16);
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.hero-deco-1 {
  width: 180rpx;
  height: 180rpx;
  right: -60rpx;
  top: -70rpx;
}

.hero-deco-2 {
  width: 90rpx;
  height: 90rpx;
  left: -30rpx;
  bottom: -40rpx;
}

.hero-main {
  flex: 1;
  position: relative;
  z-index: 2;
  min-width: 0;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 14rpx;
  line-height: 1.35;
}

.hero-sub {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 6rpx;
}

.hero-bar {
  width: 92%;
  margin-top: 14rpx;
  background: rgba(255, 255, 255, 0.7);
}

.hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.hero-actions .btn {
  padding: 0 24rpx;
}

.hero-pet {
  width: 200rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}

.pet-name {
  margin-top: -6rpx;
  padding: 2rpx 16rpx;
  background: #fffdf7;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 0 var(--ink);
}

/* 任务 */
.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed var(--line);
}

.task-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.task-emoji {
  font-size: 34rpx;
  width: 44rpx;
  text-align: center;
}

.task-title {
  font-size: 25rpx;
  font-weight: 700;
}

.task-count {
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 700;
}

.task-bar {
  margin-top: 8rpx;
}

.task-bar-done .bar-inner,
.task-bar-done {
  background: var(--green);
}

.task-btn {
  flex: none;
  padding: 0 18rpx;
}

.task-reward {
  flex: none;
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 700;
}

.task-claimed {
  flex: none;
  font-size: 20rpx;
  color: var(--green);
  font-weight: 800;
}

/* 玩法 */
.section-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 4rpx 18rpx;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feature {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 6rpx 14rpx;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 26rpx;
  box-shadow: 0 7rpx 0 rgba(59, 46, 42, 0.14);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: 3rpx solid var(--ink);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 0 rgba(59, 46, 42, 0.18);
}

.bg-purple {
  background: var(--purple-soft);
}

.bg-blue {
  background: var(--blue-soft);
}

.bg-green {
  background: var(--green-soft);
}

.bg-pink {
  background: var(--pink-soft);
}

.bg-orange {
  background: #ffe7c8;
}

.bg-red {
  background: #ffe0e0;
}

.feature-name {
  font-size: 21rpx;
  font-weight: 800;
  margin-top: 4rpx;
}

.feature-desc {
  font-size: 18rpx;
  color: var(--muted);
  transform: scale(0.92);
}

/* 剧情 */
.story-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--purple-soft);
  border: 4rpx solid var(--ink);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 0 rgba(59, 46, 42, 0.13);
}

.story-emoji {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  background: #fff;
  border: 4rpx solid var(--ink);
  border-radius: 26rpx;
  box-shadow: 0 5rpx 0 rgba(59, 46, 42, 0.18);
}

.story-tag {
  font-size: 19rpx;
  font-weight: 800;
  color: #fff;
  background: var(--purple);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.story-title {
  font-size: 26rpx;
  font-weight: 800;
}

.story-desc {
  display: block;
  font-size: 21rpx;
  color: var(--ink-soft);
  margin: 6rpx 0 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-bar {
  width: 100%;
  background: rgba(255, 255, 255, 0.75);
}

.story-arrow {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink-soft);
}

/* 数据条 */
.stat-strip {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 12rpx;
  background: #fffdf7;
  border: 4rpx solid var(--ink);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 0 rgba(59, 46, 42, 0.12);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--muted);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--line);
}

/* 每日一句 */
.quote-card {
  position: relative;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: var(--ink);
  color: #fff;
  border-radius: 32rpx;
  border: 4rpx solid var(--ink);
  box-shadow: 0 10rpx 0 rgba(59, 46, 42, 0.2);
  overflow: hidden;
}

.quote-mark {
  position: absolute;
  right: 18rpx;
  top: -10rpx;
  font-size: 140rpx;
  color: rgba(255, 255, 255, 0.1);
  font-weight: 800;
}

.quote-en {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
  position: relative;
  z-index: 2;
}

.quote-cn {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 10rpx;
}

.quote-author {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 10rpx;
}

.quote-plan {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  color: var(--yellow);
  font-weight: 700;
}

.footer-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 32rpx;
}
